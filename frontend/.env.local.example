# Base URL of the Django REST API consumed by the frontend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Used by Docker Compose for server-side (SSR) fetches over the compose network.
# Not needed for host-based `npm run dev`. The browser uses the public URL above.
# API_INTERNAL_BASE_URL=http://backend:8000/api/v1

# Rights-holder takedown contact (shown in the footer and the Acerca de page).
# Replace before going public.
NEXT_PUBLIC_CONTACT_EMAIL=derechos@basketstats.example

# Public GitHub repository URL (shown in the footer).
NEXT_PUBLIC_GITHUB_URL=https://github.com/<org>/basquetestads

# Canonical public URL of the site (used by robots.txt and sitemap.xml).
# Set to your production domain before deploying.
NEXT_PUBLIC_SITE_URL=https://basketstats.es
