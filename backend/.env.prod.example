# Copy to backend/.env.prod (never commit it). Referenced by docker-compose.prod.yml.
DJANGO_SECRET_KEY=generate-with-python-secrets-token_urlsafe-50
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.es,backend

# Must use the same password as POSTGRES_PASSWORD in the root .env.prod.
DATABASE_URL=postgres://basketball_stats:change-me@db:5432/basketball_stats
REDIS_URL=redis://redis:6379/0
# API response cache: keep it on a different Redis database than Celery (/0),
# because invalidation flushes the whole cache database.
REDIS_CACHE_URL=redis://redis:6379/1

CORS_ALLOWED_ORIGINS=https://example.es

SENTRY_DSN=
INGEST_STORE_MEDIA=True

# Public API rate limit per client IP (uncached requests arriving through Caddy);
# server-side rendering calls are exempt. API_NUM_PROXIES = proxies in front of
# the backend (Caddy = 1).
# API_THROTTLE_RATE=300/min
# API_NUM_PROXIES=1
