# Copy to backend/.env and adjust as needed. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend

# Database (matches docker-compose service "db")
DATABASE_URL=postgres://basketball_stats:basketball_stats@db:5432/basketball_stats

# Redis (Celery broker + Django cache; matches docker-compose service "redis")
REDIS_URL=redis://redis:6379/0

# CORS: comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional Sentry DSN (leave empty to disable)
SENTRY_DSN=
