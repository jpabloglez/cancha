# Copy to .env.prod (never commit it) and fill in. Used by docker-compose.prod.yml:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# Public hostnames served by Caddy (DNS A records must point at this server).
DOMAIN=example.es
API_DOMAIN=api.example.es

# Postgres credentials (the same password is used to build DATABASE_URL below).
POSTGRES_PASSWORD=change-me

# Frontend build-time values (inlined into the browser bundle at build).
NEXT_PUBLIC_API_BASE_URL=https://api.example.es/api/v1
NEXT_PUBLIC_SITE_URL=https://example.es
NEXT_PUBLIC_CONTACT_EMAIL=derechos@example.es
NEXT_PUBLIC_GITHUB_URL=https://github.com/jpabloglez/cancha

# Optional tuning (defaults shown). Benchmarks (docs/performance-analysis.md)
# favour 3 sync workers on a 2 vCPU VPS; Redis is capped so the cache cannot grow
# without bound.
# GUNICORN_WORKERS=3
# REDIS_MAXMEMORY=256mb
